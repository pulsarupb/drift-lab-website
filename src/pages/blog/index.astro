---
import Layout from "../../layouts/Layout.astro"
import Header from "../../components/Header.astro"
import Footer from "../../components/Footer.astro"
import { getPublishedPosts, postSlug, resolvePostMembers } from "../../data/blog"
import { teamDisplayName } from "../../data/teams"
import { memberSlug } from "../../data/members"

const posts = await getPublishedPosts()

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  })
}
---

<Layout title="Blog" description="Updates from Drift Lab teams and members." type="website">
  <Header />
  <main class="blog-page">
    <div class="container">
      <h1>Lab Blog</h1>
      <p class="intro">Engineering updates, milestones, and field notes from our teams.</p>

      <div class="post-grid">
        {posts.map((post) => {
          const postMembers = resolvePostMembers(post)

          return (
            <article class="post-card">
              <p class="meta">
                <span>{formatDate(post.data.publishDate)}</span>
                <span>{teamDisplayName(post.data.team)}</span>
              </p>
              <h2>
                {post.data.title}
              </h2>
              <p>{post.data.description}</p>
              {postMembers.length > 0 && (
                <p class="members">
                  By{" "}
                  {postMembers.map((member, index) => (
                    <>
                      <a href={`/members/${memberSlug(member)}`}>{member.name}</a>
                      {index < postMembers.length - 1 && <span>, </span>}
                    </>
                  ))}
                </p>
              )}
              <a
                class="post-card-link"
                href={`/blog/${postSlug(post)}`}
                aria-label={`Read post: ${post.data.title}`}
              />
            </article>
          )
        })}
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .blog-page {
    min-height: 100vh;
    padding: calc(clamp(2rem, 4vw, 4rem) + 80px) 0 clamp(3rem, 6vw, 6rem);
  }

  h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .intro {
    margin: 0.7rem 0 1.6rem;
    color: var(--color-text-muted);
  }

  .post-grid {
    display: grid;
    gap: 1rem;
  }

  .post-card {
    position: relative;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 1rem;
    cursor: pointer;
  }

  .post-card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .meta {
    margin: 0;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.74rem;
    display: flex;
    gap: 0.65rem;
  }

  h2 {
    margin: 0.6rem 0 0.45rem;
  }

  h2 {
    color: #fff;
    line-height: 1.35;
    text-wrap: balance;
  }

  .post-card > p {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .members {
    position: relative;
    z-index: 2;
    margin-top: 0.7rem;
  }

  .members a {
    position: relative;
    z-index: 3;
    color: #fff;
    text-decoration: none;
  }
</style>
