---
import sponsorsData, { type Sponsor } from "../data/sponsors/index"

interface Props {
  title?: string
  description?: string
  sponsors?: Sponsor[]
}

const {
  title = "Our Sponsors",
  description = "Organizations supporting our research, competitions, and student innovation.",
  sponsors = sponsorsData,
} = Astro.props
---

<section id="sponsors" class="sponsors-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{title}</h2>
      <p class="section-desc">{description}</p>
    </div>

    <ul class="sponsors-bullets">
      {
        sponsors.map((sponsor) => (
          <li class="sponsor-card">
            <h3 class="sponsor-name">{sponsor.name}</h3>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sponsors-section {
    padding: clamp(3rem, 6vw, 6rem) 0;
    position: relative;
    background: radial-gradient(
      circle at 50% 0%,
      rgba(255, 255, 255, 0.03) 0%,
      transparent 50%
    );
  }

  .section-header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    letter-spacing: 0.05em;
    color: #fff;
    text-transform: uppercase;
  }

  .section-desc {
    color: var(--color-text-muted);
    max-width: 650px;
    margin: 0 auto;
    font-size: clamp(1rem, 2vw, 1.1rem);
    line-height: 1.6;
    padding: 0 1rem;
  }

  .sponsors-bullets {
    display: flex;
    flex-flow: row wrap;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .sponsor-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.85rem 1.1rem;
    width: fit-content;
    max-width: 100%;
    flex: 0 0 auto;
  }

  .sponsor-name {
    color: #fff;
    margin: 0;
    font-size: 1rem;
    line-height: 1.3;
    white-space: nowrap;
  }

</style>
