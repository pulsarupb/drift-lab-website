---
import members, { memberSlug, mockMemberPhotoUrl } from "../data/members/index"
import type { Member } from "../data/members/index"
import { SocialPlatform } from "../data/members/index"
import "@phosphor-icons/web/regular"

function getImagePath(member: Member): string {
  return member.photoUrl ?? mockMemberPhotoUrl
}

function formatMemberTeams(member: Member): string {
  return member.team.join(", ")
}

function formatMemberRoles(member: Member): string {
  return member.role.join(", ")
}



function socialIconClass(platform: SocialPlatform): string {
  if (platform === SocialPlatform.GITHUB) return "ph ph-github-logo"
  if (platform === SocialPlatform.LINKEDIN) return "ph ph-linkedin-logo"
  return "ph ph-globe"
}

function hasRealPhoto(member: Member): boolean {
  return member.photoUrl !== null
}

function shuffleMembers(list: Member[]): Member[] {
  const shuffled = [...list]

  for (let i = shuffled.length - 1; i > 0; i -= 1) {
    const j = Math.floor(Math.random() * (i + 1))
    const temp = shuffled[i]
    shuffled[i] = shuffled[j]
    shuffled[j] = temp
  }

  return shuffled
}

function isPreferredMember(member: Member): boolean {
  const normalizedName = member.name
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()

  // yes, I can be biased, so please don't move me down the list
  return normalizedName.includes("lazar dragos george")
}

function sortMembersByPhotoThenName(a: Member, b: Member): number {
  return a.name.localeCompare(b.name)
}

const supervisors = members
  .filter((member) => member.isSupervisor)
  .sort(sortMembersByPhotoThenName)

const preferredMembers = members
  .filter((member) => !member.isSupervisor && isPreferredMember(member))
  .sort(sortMembersByPhotoThenName)

const remainingMembers = members.filter(
  (member) => !member.isSupervisor && !isPreferredMember(member),
)

const membersWithPhotos = shuffleMembers(remainingMembers.filter(hasRealPhoto))

const membersWithoutPhotos = remainingMembers
  .filter((member) => !hasRealPhoto(member))
  .sort(sortMembersByPhotoThenName)

const allMembers = [
  ...supervisors,
  ...preferredMembers,
  ...membersWithPhotos,
  ...membersWithoutPhotos,
]
---

<section id="members" class="members-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Our Members</h2>
      <p class="section-desc">
        Meet the talented individuals driving innovation in our laboratory.
      </p>
    </div>

    <div class="members-grid">
      {
        allMembers.map((member) => (
          <article class="member-card">
            <div class="member-sidebar">
              <a
                class="member-image-link"
                href={`/members/${memberSlug(member)}`}
                aria-label={`View profile for ${member.name}`}
              >
                <div class="member-image-wrapper">
                  <img
                    src={getImagePath(member)}
                    alt={`${member.name} - ${formatMemberRoles(member)} at ${formatMemberTeams(member)}`}
                    class="member-image"
                    loading="lazy"
                    width="300"
                    height="300"
                  />
                </div>
              </a>
              <div class="member-socials" aria-label={`${member.name} social links`}>
                {member.socialLinks?.map((link) => (
                  <a
                    class="member-social-icon"
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={link.platform}
                    aria-label={`${member.name} ${link.platform}`}
                  >
                    <i class={socialIconClass(link.platform)} aria-hidden="true"></i>
                  </a>
                ))}
              </div>
            </div>
            <div class="member-content">
              <a
                class="member-name-link"
                href={`/members/${memberSlug(member)}`}
                aria-label={`View profile for ${member.name}`}
              >
                <h4 class="member-name">{member.name}</h4>
              </a>
              <span class="member-role">{formatMemberRoles(member)} at {formatMemberTeams(member)}</span>
              <p class="member-desc">{member.shortDesc}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .members-section {
    padding: clamp(3rem, 6vw, 6rem) 0;
    position: relative;
    background: radial-gradient(
      circle at 50% 0%,
      rgba(255, 255, 255, 0.03) 0%,
      transparent 50%
    );
  }

  .section-header {
    text-align: center;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    letter-spacing: 0.05em;
    color: var(--color-primary);
    text-transform: uppercase;
  }

  .section-desc {
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
    font-size: clamp(1rem, 2vw, 1.1rem);
    line-height: 1.6;
    padding: 0 1rem;
  }

  .members-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 450px), 1fr));
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .member-card {
    position: relative;
    background: var(--color-surface);
    border-radius: 0;
    padding: clamp(1.5rem, 3vw, 2rem);
    overflow: hidden;
    border: 1px solid var(--color-border);
    transition: all 0.2s ease;
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    min-height: auto;
  }

  .member-sidebar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .member-image-link {
    text-decoration: none;
  }

  .member-name-link {
    text-decoration: none;
    color: inherit;
  }

  .member-name-link:hover .member-name {
    color: var(--color-primary);
  }

  .member-card:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-primary);
  }

  .member-image-wrapper {
    position: relative;
    width: 150px;
    aspect-ratio: 1;
    border-radius: 0;
    overflow: hidden;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
  }

  .member-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 0.4s ease;
  }

  .member-card:hover .member-image {
    transform: scale(1.05);
  }

  .member-content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .member-name {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    margin-bottom: 0.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: #fff;
    transition: color 0.2s ease;
  }

  .member-role {
    font-size: 0.875rem;
    color: var(--color-accent-pulsar);
    font-weight: 600;
    margin-bottom: 1rem;
    line-height: 1.4;
  }

  .member-socials {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .member-social-icon {
    width: 1.5rem;
    height: 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .member-social-icon:hover {
    color: var(--color-primary);
  }

  .member-social-icon i {
    font-size: 1rem;
  }

  .member-desc {
    color: var(--color-text-muted);
    line-height: 1.7;
    font-size: clamp(0.9rem, 1.8vw, 1rem);
    margin-top: 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .members-grid {
      grid-template-columns: 1fr;
    }

    .member-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    
    .member-sidebar {
      margin-bottom: 1rem;
    }
  }
</style>
