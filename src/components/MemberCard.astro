---
import {
  SocialPlatform,
  memberSlug,
  mockMemberPhotoUrl,
} from "../data/members/index"
import type { Member } from "../data/members/index"
import { teamDisplayName } from "../data/teams/index"

interface Props {
  member: Member
  variant: "big" | "small"
  roleColor?: string
  nearbyName?: string
}

const { member, variant, roleColor, nearbyName } = Astro.props

function formatMemberTeams(targetMember: Member): string {
  return targetMember.team.map(teamDisplayName).join(", ")
}

function formatMemberRoles(targetMember: Member): string {
  return targetMember.role.join(", ")
}

function splitMemberNameForCard(name: string, adjacentName?: string): string[] {
  const normalizedName = name.replace(/ - /g, "-")
  let parts = normalizedName.trim().split(/\s+/)

  if (parts.length === 1) return [name]

  const lettersPerLine = variant === "big" ? 15 : 10
  parts = parts.flatMap((part) =>
    part.length > lettersPerLine ? part.split("-") : [part],
  )

  const getMaxLines = (name?: string) => {
    const length = name?.length || 0
    return Math.ceil(length / lettersPerLine)
  }

  const maxLines = Math.max(getMaxLines(name), getMaxLines(adjacentName))

  if (parts.length <= maxLines) {
    const totalParts = parts.length
    const extraLines = maxLines - totalParts
    const emptyParts = Array(extraLines).fill("")
    return [...parts, ...emptyParts]
  }

  return parts
}

function socialIconClass(platform: SocialPlatform): string {
  if (platform === SocialPlatform.GITHUB) return "ph ph-github-logo"
  if (platform === SocialPlatform.LINKEDIN) return "ph ph-linkedin-logo"
  return "ph ph-globe"
}

function sortedSocialLinks(targetMember: Member) {
  const order: Record<SocialPlatform, number> = {
    [SocialPlatform.PORTFOLIO_WEBSITE]: 0,
    [SocialPlatform.LINKEDIN]: 1,
    [SocialPlatform.GITHUB]: 2,
  }

  return [...(targetMember.socialLinks ?? [])].sort(
    (a, b) => order[a.platform] - order[b.platform],
  )
}

const cardStyle = roleColor ? `--member-role-color: ${roleColor}` : undefined
---

<article
  class:list={["member-card", `member-card--${variant}`]}
  style={cardStyle}
>
  <a
    class="member-card-link"
    href={`/members/${memberSlug(member)}`}
    aria-label={`View profile for ${member.name}`}
  >
  </a>

  <div class="member-sidebar">
    <div class="member-image-wrapper">
      <img
        src={member.photoUrl ?? mockMemberPhotoUrl}
        alt={`${member.name} - ${formatMemberRoles(member)} at ${formatMemberTeams(member)}`}
        class="member-image"
        loading="lazy"
        width="300"
        height="300"
      />
    </div>
    {
      variant === "big" && (
        <div class="member-socials" aria-label={`${member.name} social links`}>
          {sortedSocialLinks(member).map((link) => (
            <a
              class="member-social-icon"
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              title={link.platform}
              aria-label={`${member.name} ${link.platform}`}
            >
              <i class={socialIconClass(link.platform)} aria-hidden="true" />
            </a>
          ))}
        </div>
      )
    }
  </div>

  <div class="member-content">
    <h4 class="member-name">
      <span class="member-name-text">
        {
          splitMemberNameForCard(member.name, nearbyName).map(
            (part, index, parts) => (
              <>
                <span class="member-name-part">{part}</span>
                {index < parts.length - 1 && <br />}
              </>
            ),
          )
        }
      </span>
    </h4>
    <span class="member-role">
      {formatMemberRoles(member)}{
        variant === "big" && ` at ${formatMemberTeams(member)}`
      }
    </span>
    <p class="member-desc">{member.shortDesc}</p>
  </div>
</article>

<style>
  .member-card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .member-card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .member-sidebar,
  .member-content,
  .member-image-wrapper,
  .member-image {
    position: relative;
    z-index: 2;
  }

  .member-card:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-primary);
  }

  .member-card:hover .member-image {
    transform: scale(1.05);
  }

  .member-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 0.4s ease;
  }

  .member-content {
    min-width: 0;
    min-height: 0;
    pointer-events: none;
    display: flex;
    flex-direction: column;
  }

  .member-name {
    margin: 0;
    min-height: 3.6em;
    display: flex;
    align-items: flex-end;
    color: #fff;
    line-height: 1.2;
  }

  .member-name-text {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-wrap: balance;
  }

  .member-name-part {
    white-space: nowrap;
  }

  .member-role {
    margin: 0.35rem 0 0;
    color: var(--member-role-color, var(--color-accent-pulsar));
    font-family: var(--font-heading);
  }

  .member-desc {
    margin: 0.5rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .member-card--big {
    border-radius: 0;
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
  }

  .member-card--big .member-sidebar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .member-card--big .member-image-wrapper {
    width: 150px;
    aspect-ratio: 1;
    border-radius: 0;
    overflow: hidden;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    pointer-events: none;
  }

  .member-card--big .member-content {
    flex: 1;
  }

  .member-card--big .member-name {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-weight: 700;
  }

  .member-card--big .member-role {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    text-transform: none;
    letter-spacing: normal;
  }

  .member-card--big .member-desc {
    font-size: clamp(0.9rem, 1.8vw, 1rem);
    line-height: 1.7;
    -webkit-line-clamp: 4;
  }

  @media (max-width: 640px) {
    .member-card--big .member-name {
      min-height: 0;
    }
  }

  .member-card--small {
    padding: 0.8rem;
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 0.9rem;
    min-height: 126px;
  }

  .member-card--small .member-image-wrapper {
    width: 96px;
    height: 96px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
  }

  .member-card--small .member-name {
    font-size: 1rem;
    font-weight: 700;
  }

  .member-card--small .member-role {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .member-card--small .member-desc {
    font-size: 0.8rem;
    line-height: 1.4;
    -webkit-line-clamp: 3;
  }

  @media (max-width: 980px) {
    .member-card--small .member-name {
      min-height: 0;
    }
  }

  .member-socials {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    z-index: 3;
    pointer-events: auto;
  }

  .member-social-icon {
    width: 1.5rem;
    height: 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
    z-index: 3;
  }

  .member-social-icon:hover {
    color: var(--color-primary);
  }

  .member-social-icon i {
    font-size: 1rem;
  }

  @media (max-width: 640px) {
    .member-card--big {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .member-card--big .member-content {
      align-items: center;
    }

    .member-card--big .member-name {
      justify-content: center;
      text-align: center;
      width: 100%;
    }

    .member-card--big .member-name-text {
      text-align: center;
    }

    .member-card--big .member-sidebar {
      margin-bottom: 1rem;
    }
  }
</style>
