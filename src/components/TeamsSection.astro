---
import members from "../data/members/index"
import teams, { teamSlug } from "../data/teams/index"
import type { TeamId } from "../data/teams/index"

function memberCount(teamId: TeamId): number {
  return members.filter((member) => member.team.includes(teamId)).length
}
---

<section id="teams" class="teams-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Our Teams</h2>
      <p class="section-desc">
        Three specialized teams pushing the boundaries of autonomous vehicle
        technology.
      </p>
    </div>

    <div class="teams-grid">
      {
        teams.map((team) => (
          <article class="team-card" style={`--accent: ${team.color}`}>
            <a
              class="team-card-link"
              href={`/teams/${teamSlug(team)}`}
              aria-label={`View ${team.name} team page`}
            ></a>
            <div class="card-content">
              <h3 class="team-name">{team.name}</h3>
              <span
                class="team-focus"
                style={`color: ${team.color}; border-color: ${team.color}40; background: ${team.color}10`}
              >
                {team.focus}
              </span>
              <p class="team-meta">{memberCount(team.id)} members</p>
              <p class="team-desc">{team.description}</p>
            </div>
            <div class="card-arrow">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M5 12H19M19 12L12 5M19 12L12 19"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .teams-section {
    padding: clamp(3rem, 6vw, 6rem) 0;
    position: relative;
    background: radial-gradient(
      circle at 50% 0%,
      rgba(255, 255, 255, 0.03) 0%,
      transparent 50%
    );
  }

  .section-header {
    text-align: center;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    letter-spacing: 0.05em;
    color: var(--color-primary);
    text-transform: uppercase;
  }

  .section-desc {
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
    font-size: clamp(1rem, 2vw, 1.1rem);
    line-height: 1.6;
    padding: 0 1rem;
  }

  .teams-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(1.5rem, 4vw, 2.5rem);
    perspective: 1000px;
  }

  .team-card {
    position: relative;
    background: var(--color-surface);
    border-radius: 0;
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
    overflow: hidden;
    border: 1px solid var(--color-border);
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: clamp(280px, 40vh, 320px);
  }

  .team-card-link {
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  .team-card:hover {
    background: var(--color-surface-hover);
    border-color: var(--accent);
  }



  .card-content {
    position: relative;
    z-index: 2;
    pointer-events: none;
  }

  .card-arrow {
    position: relative;
    z-index: 2;
    pointer-events: none;
  }

  .team-meta {
    margin: 0 0 1rem;
    font-size: 0.75rem;
    font-family: var(--font-heading);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .team-name {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 0.75rem;
    font-weight: 700;
    line-height: 1.1;
    color: #fff;
    min-height: clamp(3.5rem, 6vw, 4.4rem);
    display: flex;
    align-items: flex-end;
  }

  .team-focus {
    font-size: 0.75rem;
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    margin-bottom: 2rem;
    display: inline-block;
    padding: 0.5rem 1rem;
    background: transparent;
    border-radius: 0;
    border: 1px solid;
    white-space: nowrap;
  }

  .team-desc {
    color: var(--color-text-muted);
    line-height: 1.7;
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    margin-bottom: 2rem;
  }

  .card-arrow {
    align-self: flex-end;
    width: 40px;
    height: 40px;
    border-radius: 0;
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: all 0.2s;
    background: transparent;
  }

  .card-arrow svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
    transition: transform 0.3s;
  }

  .team-card:hover .card-arrow {
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
    transform: rotate(-45deg);
  }

  @media (max-width: 640px) {
    .teams-grid {
      grid-template-columns: 1fr;
    }

    .team-card {
      min-height: auto;
    }
  }
</style>
