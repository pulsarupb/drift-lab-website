---
import { Image } from 'astro:assets';
import { applicationUrl, recruitmentPostUrl } from '../data/recruitment';
import poster1 from '../data/recruitment/poster-1.webp';
import poster2 from '../data/recruitment/poster-2.webp';
import poster3 from '../data/recruitment/poster-3.webp';
import poster4 from '../data/recruitment/poster-4.webp';
import poster5 from '../data/recruitment/poster-5.webp';
import poster6 from '../data/recruitment/poster-6.webp';

const posters = [
  { image: poster1, alt: 'Drift Lab is recruiting you. A robotic arm and rover illustrate the recruitment announcement.' },
  { image: poster2, alt: 'Apply to Mechanical, Electrical, Software, Science, Media & Design, or Social Media.' },
  { image: poster3, alt: 'Drift Lab members with their rover. We welcome students with or without experience who are curious, determined and willing to learn.' },
  { image: poster4, alt: 'A student working beside a rover at CAMPUS. Gain hands-on experience, develop industry-relevant skills and strengthen your CV with real projects.' },
  { image: poster5, alt: 'Find your people. Students gathered around a robot. Join a community, make friends and build something together.' },
  { image: poster6, alt: 'Where can you apply? The application form is linked in our Instagram bio and in the Apply now button on this page.' },
];
---

<section id="join" class="recruitment" aria-labelledby="recruitment-title">
  <div class="container">
    <div class="intro">
      <div>
        <p class="eyebrow"><span aria-hidden="true"></span> Applications are open</p>
        <h2 id="recruitment-title">Your next chapter.<br /><span>Join Drift Lab.</span></h2>
      </div>
      <div class="intro-copy">
        <p>
          Build autonomous vehicles. Meet your people. Learn by doing.
          We’re looking for curious, determined students, with or without experience,
          who want to create something together.
        </p>
        <p class="departments">
          Mechanical · Electrical · Software · Science · Media &amp; Design · Social Media
        </p>
      </div>
    </div>

    <a class="apply-link" href={applicationUrl} target="_blank" rel="noopener noreferrer">
      <span class="apply-copy">
        <span class="apply-label">Apply now</span>
        <span class="apply-detail">Open the application form</span>
      </span>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
      </svg>
    </a>

    <div class="gallery-heading">
      <p>Find your place in the lab</p>
      <a href={recruitmentPostUrl} target="_blank" rel="noopener noreferrer">View on Instagram <span aria-hidden="true">↗</span></a>
    </div>
    <div class="poster-grid">
      {posters.map(({ image, alt }, index) => (
        <a class="poster" href={image.src} target="_blank" rel="noopener noreferrer" aria-label={`View recruitment slide ${index + 1} at full size: ${alt}`}>
          <Image src={image} alt={alt} widths={[360, 540, 720, 1080]} sizes="(max-width: 600px) calc(100vw - 32px), (max-width: 960px) 46vw, 368px" loading="lazy" />
          <span class="poster-caption"><span>0{index + 1} / 06</span><span>View full size <span aria-hidden="true">↗</span></span></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .recruitment {
    padding: clamp(3rem, 7vw, 6rem) 0;
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
    scroll-margin-top: 6rem;
  }

  .intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 1rem;
  }

  .eyebrow span {
    width: 0.5rem;
    height: 0.5rem;
    background: currentColor;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3.1vw, 2.6rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  h2 span { color: var(--color-primary); }

  .intro-copy p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .intro-copy .departments {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--color-text-main);
  }

  .apply-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    background: var(--color-primary);
    color: var(--color-bg);
    border: 2px solid var(--color-primary);
    transition: background 0.2s, color 0.2s;
  }

  .apply-link:hover {
    background: var(--color-bg);
    color: var(--color-primary);
  }

  .apply-copy { display: grid; gap: 0.5rem; }

  .apply-label {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5.5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .apply-detail { font-size: clamp(0.875rem, 2vw, 1.1rem); }
  .apply-link svg { width: clamp(2.5rem, 7vw, 5rem); flex-shrink: 0; }

  a:focus-visible {
    outline: 3px solid var(--color-white);
    outline-offset: 5px;
  }

  .gallery-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 2.5rem 0 1rem;
    font-size: 0.9rem;
  }

  .gallery-heading p { margin: 0; color: var(--color-text-muted); }
  .gallery-heading a { text-decoration: underline; text-underline-offset: 4px; }
  .gallery-heading a:hover { color: var(--color-primary); }

  .poster-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .poster { border: 1px solid var(--color-border); background: var(--color-bg); }
  .poster:hover { border-color: var(--color-primary); }
  .poster img { display: block; width: 100%; height: auto; }

  .poster-caption {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.85rem 1rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  @media (max-width: 960px) {
    .intro { grid-template-columns: 1fr; gap: 1.25rem; }
    .poster-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 600px) {
    .poster-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .apply-link { transition: none; }
  }
</style>
