---
import Rectorat from "./Rectorat.astro"
---

<section class="hero">
  <div class="background-grid"></div>
  <div class="rectorat-mark" aria-hidden="true">
    <Rectorat />
  </div>

  <div class="container hover-container">
    <div class="hero-layout">
      <div class="hero-text">
        <h1 class="title">
          Autonomous <br />
          <span class="text-gradient">Intelligence</span>
        </h1>

        <p class="subtitle">
          Pioneering the next generation of self-driving technology through
          student-led innovation at CAMPUS Research Institute.
        </p>

        <div class="cta-group">
          <a href="#teams" class="btn btn-primary">
            Teams
            <svg viewBox="0 0 24 24" fill="none" class="icon">
              <path
                d="M5 12H19M19 12L12 5M19 12L12 19"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
              </path>
            </svg>
          </a>
          <a href="/contact" class="btn btn-secondary">Contact</a>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-vehicles" aria-hidden="true">
    <img class="vehicle vehicle-car" src="/car.svg" alt="" loading="eager" />
    <img class="vehicle vehicle-rover" src="/rover.svg" alt="" loading="eager" />
    <img class="vehicle vehicle-drone" src="/drone.svg" alt="" loading="eager" />
  </div>

  <div class="partners-strip">
    <span class="partners-label">Supported by:</span>
    <div class="partner-logos">
      <img
        src="/campus-logo.png"
        alt="CAMPUS Research Institute"
        title="CAMPUS Research Institute"
        width="70"
        height="70"
        loading="lazy"
      />
      <div class="divider"></div>
      <div class="poli-wrapper">
        <img
          src="/poli-logo.png"
          alt="Politehnica University of Bucharest"
          title="Politehnica București"
          width="70"
          height="70"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    padding-top: clamp(80px, 12vw, 120px);
    padding-bottom: clamp(20px, 8vw, 80px);
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: transparent;
  }

  .background-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 60px 60px;
    z-index: 0;
  }

  .rectorat-mark {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0.25;
    z-index: 1;
    pointer-events: none;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .rectorat-mark :global(svg) {
    width: min(80vw, 400px);
    height: auto;
    display: block;
  }

  .hero-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .title {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0;
    letter-spacing: -0.03em;
    color: #fff;
    position: relative;
    z-index: 2;
  }

  .text-gradient {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-top: 1rem;
    margin-bottom: 1rem;
    max-width: 600px;
    position: relative;
    z-index: 2;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .hero-vehicles {
    position: absolute !important;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .vehicle {
    position: absolute !important;
    display: block;
    width: clamp(80px, 11vw, 140px);
    height: auto;
    object-fit: contain;
    opacity: 0.22;
    filter: grayscale(1) contrast(120%);
  }

  .vehicle-car {
    left: clamp(0.5rem, 4vw, 4rem);
    top: clamp(20%, 26vh, 30%);
    transform: rotate(-18deg);
  }

  .vehicle-rover {
    right: clamp(0.5rem, 4vw, 4rem);
    top: clamp(22%, 28vh, 34%);
    transform: rotate(16deg);
  }

  .vehicle-drone {
    right: clamp(0.75rem, 6vw, 6rem);
    bottom: clamp(16%, 18vh, 24%);
    transform: rotate(10deg);
  }

  .cta-group {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: clamp(1.5rem, 5vw, 3rem);
    position: relative;
    z-index: 2;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: clamp(0.75rem, 2vw, 1rem) clamp(1.5rem, 4vw, 2rem);
    border-radius: 0 !important;
    font-family: var(--font-heading);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.1em;
    font-size: clamp(0.875rem, 2vw, 1rem);
    transition: all 0.2s ease;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .btn .icon {
    width: 1.2em;
    height: 1.2em;
    flex-shrink: 0;
  }

  .btn-primary {
    background: var(--color-primary);
    color: #000;
    border-color: var(--color-primary);
  }

  .btn-primary:hover {
    background: transparent;
    color: var(--color-primary);
  }

  .btn-secondary {
    background: transparent;
    color: #fff;
    border-color: var(--color-border);
  }

  .btn-secondary:hover {
    background: var(--color-surface);
    border-color: var(--color-text-main);
  }

  .partners-strip {
    position: absolute;
    bottom: clamp(1rem, 4vw, 2rem);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.5rem, 1vw, 1rem);
    z-index: 10;
  }

  .partners-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .partner-logos {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .partner-logos img {
    filter: grayscale(1) contrast(250%);
    transition: filter 0.3s ease;
  }

  .partner-logos > img {
    height: clamp(50px, 8vw, 70px);
    width: auto;
  }

  .partner-logos > img:hover {
    filter: grayscale(0) contrast(100%);
  }

  .poli-wrapper {
    width: clamp(50px, 8vw, 70px);
    height: clamp(50px, 8vw, 70px);
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: filter 0.3s;
  }

  .poli-wrapper:hover {
    background: var(--color-surface-hover);
  }

  .poli-wrapper:hover img {
    filter: grayscale(0) contrast(100%);
  }

  .poli-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .divider {
    width: 1px;
    height: 35px;
    background: rgba(255, 255, 255, 0.25);
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  @media (max-width: 1024px) {
    .hero {
      padding-top: clamp(80px, 10vw, 100px);
      padding-bottom: clamp(20px, 4vw, 40px);
    }

    .hero-layout {
      gap: clamp(1.5rem, 4vw, 3rem);
    }

    .cta-group {
      justify-content: center;
      flex-wrap: nowrap;
      width: 100%;
      max-width: 500px;
    }

    .partner-logos {
      gap: clamp(1rem, 3vw, 2rem);
    }

    .partner-logos > img {
      height: clamp(40px, 6vw, 50px);
    }

    .poli-wrapper {
      width: clamp(40px, 6vw, 50px);
      height: clamp(40px, 6vw, 50px);
    }

    .divider {
      height: clamp(20px, 4vw, 25px);
    }

    .title {
      font-size: clamp(2rem, 5vw, 2.75rem);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 70px;
      padding-bottom: 2rem;
      min-height: 100vh;
      min-height: 100dvh; /* Use dynamic viewport height for mobile */
      align-items: center; /* Center content vertically */
      justify-content: center;
    }

    .hero .container {
      padding-top: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: calc(100dvh - 70px);
    }

    .hero-layout {
      gap: 1.25rem;
      align-items: center;
      width: 100%;
    }

    .title {
      font-size: clamp(1.75rem, 6vw, 2.25rem);
      line-height: 1.1;
    }

    .subtitle {
      font-size: clamp(0.875rem, 3vw, 1rem);
      line-height: 1.5;
      max-width: 100%;
      padding: 0 0.5rem;
    }

    .cta-group {
      flex-direction: row;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
      width: 100%;
      max-width: 100%;
      padding: 0 0.5rem;
    }

    .vehicle {
      width: clamp(62px, 16vw, 90px);
      opacity: 0.16;
    }

    .vehicle-car {
      left: -0.25rem;
      top: 24%;
    }

    .vehicle-rover {
      right: -0.25rem;
      top: 30%;
    }

    .vehicle-drone {
      right: 0.2rem;
      bottom: 26%;
    }

    .btn {
      flex: 1;
      width: auto;
      padding: 0.75rem 1rem;
      font-size: 0.875rem;
      justify-content: center;
      gap: 0.5rem;
      min-width: 0;
    }

    .btn .icon {
      width: 1em;
      height: 1em;
      flex-shrink: 0;
    }

    .partners-label {
      font-size: 0.75rem;
    }

    .partner-logos {
      flex-direction: row;
      gap: 1rem;
    }

    .partner-logos > img {
      height: 36px;
    }

    .poli-wrapper {
      width: 36px;
      height: 36px;
    }

    .divider {
      width: 1px;
      height: 24px;
    }
  }
</style>
